# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# build / cache
dist/

# python
__pycache__/
*.pyc
.venv/

# brainstorm scratchpad (visual-companion mockups)
.superpowers/

# agent tooling (not part of the app)
.agents/

# runtime review state (local, changes constantly)
output/faq/tracker.json
output/faq/toggles.json

# Resources tab: self-imposed write-rate-limit tracker — ephemeral rolling-window
# counter, not meaningful data. data/strapi-credentials.enc.json (encrypted secrets)
# and data/resource-checks.json (persisted check results) are deliberately NOT
# ignored — both are meant to be committed to this private repo.
data/.write-rate-limit-state.json

# Resources tab: progress of the in-flight batch, and the detached runner's
# stderr. Both are local runtime state — the durable record is resource-checks.json.
data/.batch-state.json
data/.batch.log

# Relations tab: same split as Resources above — data/relation-checks.json IS
# committed (durable review record), these two are ephemeral runtime state.
data/.relations-batch-state.json
data/.relations-batch.log

# Relations tab: the cached content-type + corpus index (lib/relations/
# corpus-cache.js) — a large (~4,600-row), fully-derived snapshot of prod
# Strapi that goes stale the moment anyone edits content there. Regenerated
# with a "Discover"/"Refresh" click; never meaningful to commit.
data/.relations-cache.json

# Half-written workbook, if an export dies between write and rename. The real
# file (output/resources/resources-tagging.xlsx) IS committed.
output/resources/*.tmp

# Same pattern for the Relations tab's review workbook
# (output/relations/relations-mapping.xlsx) — that file IS committed.
output/relations/*.tmp

# Doctors tab: 3.3 MB of portraits fetched from english.sysucc.org.cn. Binaries
# that never diff usefully, and `node scripts/fetch-doctor-photos.js` rebuilds
# them from data/doctor-photos.json's source URLs, which IS committed.
public/doctors/
